# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Choose your LLM provider: "openai", "gemini", "gemini_finetuned", or "openrouter"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Google/Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FINETUNED_MODEL=your_finetuned_model_name

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku:beta

# --- GCP (for production data) ---
GCP_PROJECT_ID=your_gcp_project_id
GCP_BUCKET_NAME=your_gcs_bucket_name
DATA_SOURCE=mock  # or "gcp" for production

# ============================================================================
# LANGSMITH OBSERVABILITY (Optional but recommended)
# ============================================================================
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=derivatives-gpt
ENABLE_LANGSMITH=true

# LangSmith Tagging
LANGSMITH_TAG_PRODUCT_TYPE=true
LANGSMITH_TAG_ASSET_CLASS=true
LANGSMITH_TAG_PRICING_METHOD=true
LANGSMITH_TAG_TICKER=false  # Privacy: disable if using real user data

# LangSmith Metrics
LANGSMITH_TRACK_METRICS=true

# ============================================================================
# PRICING CONFIGURATION
# ============================================================================
DEFAULT_RISK_FREE_RATE=0.05
DAYS_PER_YEAR=365

# Treasury Rate Fallbacks (update monthly from treasury.gov)
RISK_FREE_RATE_1MONTH=0.0540
RISK_FREE_RATE_3MONTH=0.0525
RISK_FREE_RATE_6MONTH=0.0510
RISK_FREE_RATE_1YEAR=0.0495
RISK_FREE_RATE_DEFAULT=0.0480

# ============================================================================
# RAG (Retrieval-Augmented Generation) SETTINGS
# ============================================================================
RAG_ENABLED=true
RAG_INDEX_PATH=data/vectorstore/rag_index_structured.faiss
RAG_METADATA_PATH=data/vectorstore/metadata_structured.json
RAG_BM25_CANDIDATE_COUNT=20
RAG_RERANK_CANDIDATE_COUNT=10
RAG_FINAL_SOURCE_COUNT=3
RAG_EMBEDDING_MODEL=models/text-embedding-004

# ============================================================================
# SPECIALIZED NODE MODELS (Override defaults per node type)
# ============================================================================
# Classification
CLASSIFICATION_OPENAI_MODEL=gpt-4o-mini
CLASSIFICATION_GEMINI_MODEL=gemini-1.5-flash
CLASSIFICATION_OPENROUTER_MODEL=anthropic/claude-3-haiku:beta

# Planning
PLANNER_OPENAI_MODEL=gpt-4o-mini
PLANNER_GEMINI_MODEL=gemini-1.5-flash
PLANNER_OPENROUTER_MODEL=anthropic/claude-3-haiku:beta

# Decomposition
DECOMPOSER_OPENAI_MODEL=gpt-4o-mini
DECOMPOSER_GEMINI_MODEL=gemini-1.5-flash
DECOMPOSER_OPENROUTER_MODEL=anthropic/claude-3-haiku:beta

# Validation
VALIDATOR_OPENAI_MODEL=gpt-4o-mini
VALIDATOR_GEMINI_MODEL=gemini-1.5-flash
VALIDATOR_OPENROUTER_MODEL=anthropic/claude-3-haiku:beta

# ============================================================================
# AGENT BEHAVIOR
# ============================================================================
MAX_AGENT_ITERATIONS=10

# ============================================================================
# CHECKPOINTING (Conversation persistence)
# ============================================================================
CHECKPOINT_DB_PATH=data/checkpoints/checkpoints.db

# ============================================================================
# WEB SEARCH (Optional)
# ============================================================================
ENABLE_WEB_SEARCH=true
TAVILY_API_KEY=your_tavily_api_key_here
