\[d\left(\begin{array}{c}X(t)\\ Y(t)\end{array}\right)=\left(\begin{array}{c}a_{X}(t)\\ a_{Y}(t)\end{array}\right)dt+\left(\begin{array}{c}b_{X}(t)^{\top}\\ b_{Y}(t)^{\top}\end{array}\right)dW(t),\]

